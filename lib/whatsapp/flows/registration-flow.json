{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "ROLE_SELECT": [
      "LAWYER_INVITE_CODE",
      "AS_REFERRER",
      "STAFF_REFERRER"
    ],
    "LAWYER_INVITE_CODE": [
      "LAWYER_DETAILS"
    ],
    "LAWYER_DETAILS": [
      "SUCCESS_ACTIVE"
    ],
    "AS_REFERRER": [
      "AS_INFO"
    ],
    "AS_INFO": [
      "SUCCESS_PENDING"
    ],
    "STAFF_REFERRER": [
      "STAFF_INFO"
    ],
    "STAFF_INFO": [
      "SUCCESS_PENDING"
    ]
  },
  "screens": [
    {
      "id": "ROLE_SELECT",
      "title": "Get Started",
      "terminal": false,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Welcome to LLM!"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "role",
            "label": "I am a/an...",
            "required": true,
            "data-source": [
              {
                "id": "lawyer",
                "title": "\u2696\ufe0f Lawyer",
                "description": "Active LSBC member in good standing"
              },
              {
                "id": "articling_student",
                "title": "\ud83c\udf31 Articling Student",
                "description": "Currently enrolled in the LSAP"
              },
              {
                "id": "legal_staff",
                "title": "\ud83d\udc65 Legal Staff",
                "description": "Support staff at a law firm"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Start Registration",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "role": "${form.role}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "LAWYER_INVITE_CODE",
      "title": "Invite Code",
      "terminal": false,
      "refresh_on_back": false,
      "data": {
        "error_message": {
          "type": "string",
          "__example__": "Error"
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "STEP 1 OF 2 \u2014 LAWYER REGISTRATION"
          },
          {
            "type": "TextHeading",
            "text": "\ud83d\udc8c Invite Code"
          },
          {
            "type": "TextBody",
            "text": "Enter the 6-character invite code you received from an existing LLM member."
          },
          {
            "type": "TextInput",
            "name": "invite_code",
            "label": "Invite Code",
            "required": true,
            "input-type": "text",
            "min-chars": 6,
            "max-chars": 6,
            "helper-text": "Example: A1B2C3"
          },
          {
            "type": "TextCaption",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "Footer",
            "label": "Verify Code",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "invite_code": "${form.invite_code}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "LAWYER_DETAILS",
      "title": "Your Details",
      "terminal": false,
      "refresh_on_back": false,
      "data": {
        "invite_code": {
          "type": "string",
          "__example__": "ABC123"
        },
        "invite_code_id": {
          "type": "string",
          "__example__": "1"
        },
        "inviter_name": {
          "type": "string",
          "__example__": "Michael Tran"
        },
        "error_message": {
          "type": "string",
          "__example__": "Error"
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "STEP 2 OF 2 \u2014 LAWYER REGISTRATION"
          },
          {
            "type": "TextHeading",
            "text": "\u270d\ufe0f Your Details"
          },
          {
            "type": "TextBody",
            "text": "\u2714\ufe0f Invited by ${data.inviter_name}"
          },
          {
            "type": "TextCaption",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Full Name",
            "required": true,
            "input-type": "text",
            "helper-text": "As it appears on the LSBC Lawyer Directory"
          },
          {
            "type": "OptIn",
            "name": "lsbc_confirmed",
            "label": "I am an active member of the Law Society of BC in good standing.",
            "required": true
          },
          {
            "type": "OptIn",
            "name": "toc_confirmed",
            "label": "I agree to only use this tool for lawful purposes and will not distribute its content to unauthorized individuals.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Complete Registration",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "full_name": "${form.full_name}",
                "lsbc_confirmed": "${form.lsbc_confirmed}",
                "invite_code": "${data.invite_code}",
                "invite_code_id": "${data.invite_code_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "AS_REFERRER",
      "title": "Lawyer Referrer",
      "terminal": false,
      "refresh_on_back": false,
      "data": {
        "error_message": {
          "type": "string",
          "__example__": "Error"
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "STEP 1 OF 2 \u2014 ARTICLING STUDENT REGISTRATION"
          },
          {
            "type": "TextHeading",
            "text": "\u2696\ufe0f Lawyer Referrer"
          },
          {
            "type": "TextBody",
            "text": "You need a registered LLM lawyer to vouch for your registration."
          },
          {
            "type": "TextCaption",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "referrer_name",
            "label": "Full Name",
            "required": true,
            "input-type": "text",
            "helper-text": "Must be a registered LLM lawyer"
          },
          {
            "type": "TextInput",
            "name": "referrer_phone",
            "label": "Phone",
            "required": true,
            "input-type": "phone"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "referrer_name": "${form.referrer_name}",
                "referrer_phone": "${form.referrer_phone}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "AS_INFO",
      "title": "Your Details",
      "terminal": false,
      "refresh_on_back": false,
      "data": {
        "error_message": {
          "type": "string",
          "__example__": "Error"
        },
        "min_date": {
          "type": "string",
          "__example__": "2026-02-12"
        },
        "max_date": {
          "type": "string",
          "__example__": "2026-11-12"
        },
        "referrer_name": {
          "type": "string",
          "__example__": "Michael Tran"
        },
        "referrer_phone": {
          "type": "string",
          "__example__": "16045551234"
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "STEP 2 OF 2 \u2014 ARTICLING STUDENT REGISTRATION"
          },
          {
            "type": "TextHeading",
            "text": "\u270d\ufe0f Your Details"
          },
          {
            "type": "TextCaption",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Your Name",
            "required": true,
            "input-type": "text"
          },
          {
            "type": "TextInput",
            "name": "principal_name",
            "label": "Principal",
            "required": true,
            "input-type": "text",
            "helper-text": "Principal's full name as appears on the LSBC Lawyer Directory"
          },
          {
            "type": "TextInput",
            "name": "firm_name",
            "label": "Firm Name",
            "required": false,
            "input-type": "text",
            "helper-text": "Leave blank if you are not at a firm"
          },
          {
            "type": "DatePicker",
            "name": "articling_end",
            "label": "Articling End Date",
            "required": true,
            "min-date": "${data.min_date}",
            "max-date": "${data.max_date}",
            "helper-text": "End date of your articling's work period (excludes PLTC)"
          },
          {
            "type": "OptIn",
            "name": "toc_confirmed",
            "label": "I agree to only use this tool for lawful purposes and will not distribute its content to unauthorized individuals.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Submit Registration",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "full_name": "${form.full_name}",
                "firm_name": "${form.firm_name}",
                "principal_name": "${form.principal_name}",
                "articling_end": "${form.articling_end}",
                "toc_confirmed": "${form.toc_confirmed}",
                "referrer_name": "${data.referrer_name}",
                "referrer_phone": "${data.referrer_phone}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "STAFF_REFERRER",
      "title": "Lawyer Referrer",
      "terminal": false,
      "refresh_on_back": false,
      "data": {
        "error_message": {
          "type": "string",
          "__example__": "Error"
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "STEP 1 OF 2 \u2014 LEGAL STAFF REGISTRATION"
          },
          {
            "type": "TextHeading",
            "text": "\u2696\ufe0f Lawyer Referrer"
          },
          {
            "type": "TextBody",
            "text": "A registered LLM lawyer must refer you to complete registration."
          },
          {
            "type": "TextCaption",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "referrer_name",
            "label": "Full Name",
            "required": true,
            "input-type": "text",
            "helper-text": "Must be a registered LLM lawyer"
          },
          {
            "type": "TextInput",
            "name": "referrer_phone",
            "label": "Phone",
            "required": true,
            "input-type": "phone"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "referrer_name": "${form.referrer_name}",
                "referrer_phone": "${form.referrer_phone}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "STAFF_INFO",
      "title": "Your Details",
      "terminal": false,
      "refresh_on_back": false,
      "data": {
        "error_message": {
          "type": "string",
          "__example__": "Error"
        },
        "referrer_name": {
          "type": "string",
          "__example__": "Michael Tran"
        },
        "referrer_phone": {
          "type": "string",
          "__example__": "16045551234"
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "STEP 2 OF 2 \u2014 LEGAL STAFF REGISTRATION"
          },
          {
            "type": "TextHeading",
            "text": "\u270d\ufe0f Your Details"
          },
          {
            "type": "TextCaption",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Full Name",
            "required": true,
            "input-type": "text"
          },
          {
            "type": "TextInput",
            "name": "firm_name",
            "label": "Firm Name",
            "required": false,
            "input-type": "text"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "staff_role",
            "label": "My role is...",
            "required": true,
            "data-source": [
              {
                "id": "legal_assistant",
                "title": "Legal Assistant"
              },
              {
                "id": "paralegal",
                "title": "Paralegal"
              },
              {
                "id": "other",
                "title": "Other"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "staff_role_other",
            "label": "Other Role",
            "required": false,
            "input-type": "text",
            "helper-text": "Only required if you selected Other"
          },
          {
            "type": "OptIn",
            "name": "toc_confirmed",
            "label": "I agree to only use this tool for lawful purposes and will not distribute its content to unauthorized individuals.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Submit Registration",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "full_name": "${form.full_name}",
                "firm_name": "${form.firm_name}",
                "staff_role": "${form.staff_role}",
                "staff_role_other": "${form.staff_role_other}",
                "toc_confirmed": "${form.toc_confirmed}",
                "referrer_name": "${data.referrer_name}",
                "referrer_phone": "${data.referrer_phone}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS_ACTIVE",
      "title": "All Done!",
      "terminal": true,
      "data": {
        "extension_message_response": {
          "type": "object",
          "__example__": {
            "params": {
              "flow_token": "token",
              "status": "active"
            }
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "\ud83c\udf89 Legendary!"
          },
          {
            "type": "TextBody",
            "text": "Your registration is now complete."
          },
          {
            "type": "TextBody",
            "text": "You can use this bot at anytime to retrieve your PIN and personal Invite Code, and verify any articling students or staff members."
          },
          {
            "type": "Footer",
            "label": "Complete",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "extension_message_response": "${data.extension_message_response}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS_PENDING",
      "title": "Registration Submitted",
      "terminal": true,
      "data": {
        "extension_message_response": {
          "type": "object",
          "__example__": {
            "params": {
              "flow_token": "token",
              "status": "pending"
            }
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "\u23f3 Now Verifying..."
          },
          {
            "type": "TextBody",
            "text": "Your registration has been submitted and is awaiting verification."
          },
          {
            "type": "TextBody",
            "text": "Please check back later or contact your referring lawyer for status updates."
          },
          {
            "type": "Footer",
            "label": "Complete",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "extension_message_response": "${data.extension_message_response}"
              }
            }
          }
        ]
      }
    }
  ]
}
