{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "VERIFY_AS_SCREEN": ["SUCCESS"],
    "VERIFY_STAFF_SCREEN": ["SUCCESS"],
    "REVERIFY_STAFF_SCREEN": ["SUCCESS"]
  },
  "screens": [
    {
      "id": "VERIFY_AS_SCREEN",
      "title": "Verify Student",
      "terminal": false,
      "data": {
        "user_id": { "type": "string", "__example__": "1" },
        "student_name": { "type": "string", "__example__": "Madeline Matlock" },
        "student_phone": { "type": "string", "__example__": "16046661234" },
        "principal_name": { "type": "string", "__example__": "Ben Matlock" },
        "articling_end": { "type": "string", "__example__": "2025-12-31" },
        "type": { "type": "string", "__example__": "articling_student" },
        "error_message": { "type": "string", "__example__": "Error" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Student Verification" },
          {
            "type": "TextBody",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "student_name_display",
            "label": "Student Name",
            "init-value": "${data.student_name}",
            "enabled": false,
            "required": false,
            "input-type": "text"
          },
          {
            "type": "TextInput",
            "name": "principal_display",
            "label": "Principal",
            "init-value": "${data.principal_name}",
            "enabled": false,
            "required": false,
            "input-type": "text"
          },
          {
            "type": "DatePicker",
            "name": "articling_end",
            "label": "Articling End Date",
            "required": true,
            "init-value": "${data.articling_end}",
            "helper-text": "Adjust the end date if it is incorrect. Do NOT include PLTC."
          },
          {
            "type": "OptIn",
            "name": "confirmed",
            "label": "I confirm this person is a current articling student with LSBC, and I accept responsibility for their use of this tool.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Verify Student",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "user_id": "${data.user_id}",
                "confirmed": "${form.confirmed}",
                "articling_end": "${form.articling_end}",
                "type": "${data.type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "VERIFY_STAFF_SCREEN",
      "title": "Verify Staff",
      "terminal": false,
      "data": {
        "user_id": { "type": "string", "__example__": "2" },
        "staff_name": { "type": "string", "__example__": "Donna Paulsen" },
        "staff_phone": { "type": "string", "__example__": "17786661337" },
        "staff_role": { "type": "string", "__example__": "Paralegal" },
        "type": { "type": "string", "__example__": "legal_staff" },
        "error_message": { "type": "string", "__example__": "Error" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextSubheading", "text": "Staff Verification" },
          {
            "type": "TextBody",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "staff_name_display",
            "label": "Staff Name",
            "init-value": "${data.staff_name}",
            "enabled": false,
            "required": false,
            "input-type": "text"
          },
          {
            "type": "TextInput",
            "name": "role_display",
            "label": "Role",
            "init-value": "${data.staff_role}",
            "enabled": false,
            "required": false,
            "input-type": "text"
          },
          {
            "type": "OptIn",
            "name": "confirmed",
            "label": "I confirm this person works at my firm, and I accept responsibility for their use of this tool.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Verify Staff",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "user_id": "${data.user_id}",
                "confirmed": "${form.confirmed}",
                "type": "${data.type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVERIFY_STAFF_SCREEN",
      "title": "Re-Verify Staff",
      "terminal": false,
      "data": {
        "user_id": { "type": "string", "__example__": "2" },
        "staff_name": { "type": "string", "__example__": "Donna Paulsen" },
        "staff_phone": { "type": "string", "__example__": "17786661337" },
        "staff_role": { "type": "string", "__example__": "Paralegal" },
        "error_message": { "type": "string", "__example__": "Error" },
        "has_error": { "type": "boolean", "__example__": false },
        "type": { "type": "string", "__example__": "reverify" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextSubheading", "text": "Re-Verification" },
          {
            "type": "TextBody",
            "text": "This staff member's access is expiring soon."
          },
          {
            "type": "TextBody",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "staff_name_display",
            "label": "Staff Name",
            "init-value": "${data.staff_name}",
            "enabled": false,
            "required": false,
            "input-type": "text"
          },
          {
            "type": "TextInput",
            "name": "role_display",
            "label": "Role",
            "init-value": "${data.staff_role}",
            "enabled": false,
            "required": false,
            "input-type": "text"
          },
          {
            "type": "OptIn",
            "name": "confirmed",
            "label": "I confirm this person still works at my firm, and I accept responsibility for their use of this tool.",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "user_id": "${data.user_id}",
                "confirmed": "${form.confirmed}",
                "type": "${data.type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Complete",
      "terminal": true,
      "data": {
        "extension_message_response": {
          "type": "object",
          "__example__": {
            "params": { "flow_token": "token", "status": "verified" }
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Verification Complete" },
          {
            "type": "TextBody",
            "text": "The user has been verified and their access has been granted."
          },
          {
            "type": "Footer",
            "label": "Complete",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "extension_message_response": "${data.extension_message_response}"
              }
            }
          }
        ]
      }
    }
  ]
}
